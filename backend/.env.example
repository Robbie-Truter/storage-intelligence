# Storage Intelligence backend configuration.
# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.

# --- MCP server connection -----------------------------------------------
# Directory of the MCP server project. Defaults to <repo root>/mcp-server; set
# only to override (an absolute path avoids depending on the launch directory).
# STORAGE_BACKEND_MCP_SERVER_DIR=/absolute/path/to/mcp-server
# Console script launched via `uv run --directory <dir>` (not `uv` itself).
STORAGE_BACKEND_MCP_SERVER_COMMAND=storage-intelligence
# Extra arguments passed to the command (JSON array when set via the environment).
STORAGE_BACKEND_MCP_SERVER_ARGS=[]
# When true, fail application startup if the MCP server cannot be reached.
STORAGE_BACKEND_MCP_REQUIRED=false

# --- Agent / LLM ----------------------------------------------------------
# The model is chosen per request: GET /api/agent/models lists the catalogue
# and POST /api/agent/analyze takes the selected id in its body.
STORAGE_BACKEND_AGENT_TEMPERATURE=0.0
STORAGE_BACKEND_AGENT_MAX_ITERATIONS=10

# Provider credentials live on the backend only, never in the frontend.
# Set the keys for every provider you want selectable:
#   openai:*              (langchain-openai)
#   google_genai:*        (langchain-google-genai)
#   ollama:*              (langchain-ollama, local, no key)
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Ollama runs locally and needs no key; point it elsewhere if it is not on the
# default http://localhost:11434.
# OLLAMA_BASE_URL=http://localhost:11434

# --- HTTP / CORS ----------------------------------------------------------
# JSON array of allowed origins for the frontend.
STORAGE_BACKEND_CORS_ORIGINS=["http://localhost:5173"]
