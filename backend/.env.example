# Storage Intelligence backend configuration.
# Copy to `.env` and adjust. `.env` is gitignored; never commit real secrets.

# --- MCP server connection -----------------------------------------------
# Directory of the MCP server project, relative to the repository root.
STORAGE_BACKEND_MCP_SERVER_DIR=mcp-server
# Command used to launch the MCP server subprocess.
STORAGE_BACKEND_MCP_SERVER_COMMAND=uv
# Arguments passed to the command (JSON array when set via the environment).
STORAGE_BACKEND_MCP_SERVER_ARGS=["run","--directory","mcp-server","storage-intelligence"]
# When true, fail application startup if the MCP server cannot be reached.
STORAGE_BACKEND_MCP_REQUIRED=false

# --- Agent / LLM ----------------------------------------------------------
# Provider-agnostic init_chat_model string.
STORAGE_BACKEND_AGENT_MODEL=openai:gpt-4.1
STORAGE_BACKEND_AGENT_TEMPERATURE=0.0
STORAGE_BACKEND_AGENT_MAX_ITERATIONS=10

# Provider API keys live on the backend only, never in the frontend.
OPENAI_API_KEY=

# --- HTTP / CORS ----------------------------------------------------------
# JSON array of allowed origins for the frontend.
STORAGE_BACKEND_CORS_ORIGINS=["http://localhost:5173"]
